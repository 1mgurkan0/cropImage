{% block stylesheets %}
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #5d67e6;
            --background-color: #f0f4f8;
            --card-bg-color: #ffffff;
            --text-color: #34495e;
            --secondary-text-color: #7f8c8d;
            --border-color: #e0e6ed;
            --shadow-light: 0 4px 15px rgba(0, 0, 0, 0.05);
            --shadow-hover: 0 8px 25px rgba(0, 0, 0, 0.1);
        }
        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--background-color);
            color: var(--text-color);
        }
        .converter-card {
            background-color: var(--card-bg-color);
            border-radius: 24px;
            box-shadow: var(--shadow-light);
            padding: 2.5rem;
            border: none;
        }
        .card-title {
            font-weight: 700;
            color: var(--text-color);
            margin-bottom: 0.5rem;
        }
        .submit-btn {
            background-color: var(--primary-color);
            border: none;
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 600;
            transition: background-color 0.3s ease, transform 0.2s ease;
            color: #ffffff;
        }
        .submit-btn:hover {
            background-color: #3871c2;
            transform: translateY(-2px);
        }
        h1, h2, h3 {
            color: var(--text-color);
        }
        label {
            font-weight: 600;
            color: var(--text-color);
            margin-bottom: 0.5rem;
        }
        input[type="url"] {
            border-radius: 12px;
            border: 1px solid var(--border-color);
            padding: 10px 15px;
            transition: border-color 0.3s ease;
            width: 100%;
        }
        input[type="url"]:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.25rem rgba(74, 144, 226, 0.25);
        }
        .hidden {
            display: none;
        }
        .table {
            background-color: var(--card-bg-color);
            border-radius: 12px;
            overflow: hidden;
        }
        .table thead th {
            background-color: var(--primary-color);
            color: #ffffff;
            border-color: var(--primary-color);
        }
        .table tbody tr:nth-child(even) {
            background-color: var(--background-color);
        }
        .table tbody tr td {
            color: var(--text-color);
            border-color: var(--border-color);
        }
        .status-error {
            color: #e74c3c;
            font-weight: 600;
        }
        a {
            color: var(--primary-color);
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
        .feature-card {
            background-color: var(--card-bg-color);
            border-radius: 24px;
            box-shadow: var(--shadow-light);
            transition: transform 0.3s, box-shadow 0.3s;
            text-decoration: none;
            border: none;
        }
        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow-hover);
        }
        .card-icon svg {
            width: 64px;
            height: 64px;
            color: var(--primary-color);
        }
        .card-title-link {
            font-weight: 600;
            color: var(--text-color);
            text-decoration: none;
        }
        .card-text {
            color: var(--secondary-text-color);
        }
        .main-container {
            padding-top: 1rem;
            padding-bottom: 1rem;
        }
    </style>
{% endblock %}

<main class="container my-5">
    <div class="card p-4 shadow-lg converter-card">
        <hgroup>
            <h1 class="card-title text-center mb-4">Kırık Link Denetleyici</h1>
            <h2 class="intro-text lead mb-5 text-center">Bir sayfadaki tüm linkleri kontrol edin ve 404 gibi hataları bulun.</h2>
        </hgroup>

        <form id="broken-link-form">
            <div class="mb-3">
                <label for="url_to_check" class="form-label">Kontrol Edilecek URL</label>
                <input type="url" id="url_to_check" name="url_to_check" placeholder="https://example.com/bir-sayfa" required>
            </div>
            <button type="submit" id="submit-btn" class="submit-btn w-100">Kırık Linkleri Bul</button>
        </form>

        <div id="progress-container" class="hidden mt-4">
            <progress id="progress-bar" class="w-100"></progress>
            <p id="progress-text" class="text-center"></p>
        </div>

        <div id="results-container" class="hidden mt-4">
            <h3 class="card-title mb-3">Sonuçlar</h3>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Bulunan Link</th>
                            <th>HTTP Durum Kodu</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody id="results-tbody"></tbody>
                </table>
            </div>
        </div>
    </div>
</main>

