<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Görsel Dönüştürücü</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #4a90e2;
            --background-color: #f0f4f8;
            --card-bg-color: #ffffff;
            --text-color: #34495e;
            --secondary-text-color: #7f8c8d;
            --border-color: #e0e6ed;
            --shadow-light: 0 4px 15px rgba(0, 0, 0, 0.05);
            --shadow-hover: 0 8px 25px rgba(0, 0, 0, 0.1);
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--background-color);
            color: var(--text-color);
        }
        .main-container {
            max-width: 900px;
        }
        .converter-card {
            background-color: var(--card-bg-color);
            border-radius: 24px;
            box-shadow: var(--shadow-light);
            padding: 2.5rem;
            border: none;
        }
        .card-title {
            font-weight: 700;
            color: var(--text-color);
            margin-bottom: 0.5rem;
        }
        .intro-text {
            color: var(--secondary-text-color);
            font-size: 1rem;
            line-height: 1.6;
        }
        .intro-text li {
            margin-bottom: 0.5rem;
        }
        .file-upload-area {
            border: 2px dashed var(--border-color);
            border-radius: 16px;
            transition: border-color 0.3s ease, background-color 0.3s ease;
            cursor: pointer;
            padding: 2.5rem 1.5rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        .file-upload-area.highlight {
            border-color: var(--primary-color);
            background-color: #f1f6ff;
        }
        .file-upload-btn, .submit-btn {
            background-color: var(--primary-color);
            border: none;
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 600;
            transition: background-color 0.3s ease, transform 0.2s ease;
        }
        .file-upload-btn:hover, .submit-btn:hover {
            background-color: #3871c2;
            transform: translateY(-2px);
        }
        .form-select {
            border-radius: 12px;
            border: 1px solid var(--border-color);
            padding: 10px 15px;
            transition: border-color 0.3s ease;
        }
        .form-select:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.25rem rgba(74, 144, 226, 0.25);
        }
        .form-label {
            font-weight: 600;
            color: var(--text-color);
            margin-bottom: 0.5rem;
        }
        .preview-container {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-top: 20px;
            justify-content: center;
        }
        .preview-item {
            position: relative;
            width: 80px;
            height: 80px;
            border-radius: 12px;
            overflow: hidden;
            border: 2px solid var(--border-color);
        }
        .preview-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .remove-btn {
            position: absolute;
            top: -8px;
            right: -8px;
            background-color: #e74c3c;
            color: white;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            font-size: 16px;
            font-weight: bold;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
            transition: transform 0.2s ease;
        }
        .remove-btn:hover {
            transform: scale(1.1);
        }
        .feature-card {
            background-color: var(--card-bg-color);
            border-radius: 24px;
            box-shadow: var(--shadow-light);
            transition: transform 0.3s, box-shadow 0.3s;
            text-decoration: none;
            border: none;
        }
        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow-hover);
        }
        .card-icon svg {
            width: 64px;
            height: 64px;
            fill: var(--primary-color);
        }
        .card-title-link {
            font-weight: 600;
            color: var(--text-color);
            text-decoration: none;
        }
        .card-text {
            color: var(--secondary-text-color);
        }
    </style>
</head>
<body>
<div class="container my-5">
    <div class="card p-4 shadow-lg converter-card">
        <form method="POST" enctype="multipart/form-data">
            <h1 class="card-title text-center mb-4">Görsel Dönüştürücü</h1>

            <ul class="intro-text lead mb-5 text-start">
                <li>Cihazınızdan en fazla 10 adet görsel seçebilirsiniz veya görselleri bırakma alanına sürükleyebilirsiniz.</li>
                <li>Seçili görsel en fazla 10 MB olmak zorundadır.</li>
            </ul>

            <div class="mb-3">
                <label for="image-upload" class="form-label fw-bold text-muted">Görselleri Seç (Çoklu)</label>
                <div id="drop-area" class="file-upload-area p-5 text-center">
                    <span class="text-muted d-block mb-2">Dosyaları buraya sürükle veya</span>
                    <label for="image-upload" class="btn btn-primary file-upload-btn">Dosya Seç</label>
                    <input type="file" id="image-upload" name="images[]" class="d-none" multiple required>
                </div>
            </div>

            <div id="preview-container" class="preview-container"></div>

            <div class="mb-3">
                <label for="format-select" class="form-label fw-bold text-muted">Hedef Format</label>
                <select id="format-select" name="format" class="form-select" required>
                    <option value="webp">WEBP</option>
                    <option value="jpeg">JPEG</option>
                    <option value="png">PNG</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary w-100 mt-3 submit-btn">Dönüştür ve İndir</button>
        </form>
    </div>

</div>
<div class="container main-container text-center py-1">
    <div class="row g-4">
        <div class="col">
            <a href="{{ path('app_image_compress') }}" class="text-decoration-none">
                <div class="card p-5 feature-card h-100 d-flex flex-column align-items-center justify-content-center">
                    <span class="card-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-arrows-collapse" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h13a.5.5 1 0 0 1 0 1h-13A.5.5 0 0 1 1 8m13-3.5a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1 0-1h13a.5.5 0 0 1 .5.5m-13 7a.5.5 0 0 1 .5-.5h13a.5.5 0 0 1 0 1h-13a.5.5 0 0 1-.5-.5"/>
                        </svg>
                    </span>
                    <h2 class="card-title-link mt-3">Görsel Sıkıştırma</h2>
                    <p class="card-text text-center mt-2">Dosya boyutunu düşürerek hız kazanın. Kaliteyi korurken sıkıştırın.</p>
                </div>
            </a>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const dropArea = document.getElementById('drop-area');
        const fileInput = document.getElementById('image-upload');
        const previewContainer = document.getElementById('preview-container');

        let fileList = [];

        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropArea.addEventListener(eventName, preventDefaults, false);
        });
        ['dragenter', 'dragover'].forEach(eventName => {
            dropArea.addEventListener(eventName, () => dropArea.classList.add('highlight'), false);
        });
        ['dragleave', 'drop'].forEach(eventName => {
            dropArea.addEventListener(eventName, () => dropArea.classList.remove('highlight'), false);
        });

        dropArea.addEventListener('drop', handleDrop, false);
        fileInput.addEventListener('change', handleFiles, false);

        previewContainer.addEventListener('click', (e) => {
            if (e.target.classList.contains('remove-btn')) {
                const fileIndex = e.target.getAttribute('data-index');
                removeFile(fileIndex);
            }
        });

        function preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        }

        function handleDrop(e) {
            const dt = new DataTransfer();
            const droppedFiles = Array.from(e.dataTransfer.files);

            fileList.forEach(file => dt.items.add(file));

            for (const file of droppedFiles) {
                if (dt.items.length >= 10) {
                    alert("En fazla 10 görsel yükleyebilirsiniz!");
                    break;
                }
                dt.items.add(file);
            }

            fileList = Array.from(dt.files);
            fileInput.files = dt.files;
            updateFileListAndPreviews();
        }

        function handleFiles() {
            const newFiles = Array.from(fileInput.files);

            if (fileList.length + newFiles.length > 10) {
                alert("En fazla 10 görsel yükleyebilirsiniz!");
                return;
            }

            const dt = new DataTransfer();

            newFiles.forEach(file => dt.items.add(file));

            fileList.forEach(file => {
                if (!Array.from(newFiles).some(newFile => newFile.name === file.name)) {
                    dt.items.add(file);
                }
            });

            fileList = Array.from(dt.files);
            fileInput.files = dt.files;
            updateFileListAndPreviews();
        }

        function updateFileListAndPreviews() {
            previewContainer.innerHTML = '';
            fileList.forEach((file, index) => {
                if (!file.type.startsWith('image/')) return;

                const previewItem = document.createElement('div');
                previewItem.classList.add('preview-item');

                const img = document.createElement('img');
                img.classList.add('preview-img');

                const removeBtn = document.createElement('span');
                removeBtn.classList.add('remove-btn');
                removeBtn.innerText = '×';
                removeBtn.setAttribute('data-index', index);

                previewItem.appendChild(img);
                previewItem.appendChild(removeBtn);
                previewContainer.appendChild(previewItem);

                const reader = new FileReader();
                reader.onload = (e) => {
                    img.src = e.target.result;
                };
                reader.readAsDataURL(file);
            });
        }

        function removeFile(indexToRemove) {
            fileList.splice(indexToRemove, 1);
            updateFileListAndPreviews();
        }
    });
</script>
</body>
</html>
