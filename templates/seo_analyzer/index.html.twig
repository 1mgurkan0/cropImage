{% block javascripts %}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        $(function() {
            const domainForm = $('#domain-form');
            const submitBtn = $('#submit-btn');
            const sitemapSelectionContainer = $('#sitemap-selection-container');
            const sitemapLinks = $('#sitemap-links');
            const progressContainer = $('#progress-container');
            const progressBar = $('#progress-bar');
            const progressText = $('#progress-text');
            const resultsContainer = $('#results-container');
            const resultsTbody = $('#results-tbody');
            const analyzeSelectedBtn = $('#analyze-selected-btn');
            let totalUrls = 0, processedUrls = 0, errorCount = 0;
            const CONCURRENT_REQUESTS = 5; // Aynı anda çalışacak istek sayısı
            let activeRequests = 0;
            let queue = [];

            domainForm.on('submit', function(e) {
                e.preventDefault();
                const domainUrl = $('#domain_url').val();

                if (!domainUrl) {
                    alert('Lütfen geçerli bir domain URL si girin.');
                    return;
                }

                resetUI();
                submitBtn.attr('aria-busy', 'true').prop('disabled', true).text('Sitemap Aranıyor...');

                $.post('{{ path("api_get_sitemaps") }}', { domain: domainUrl })
                    .done(function(response) {
                        if (response.success) {
                            if (response.data.type === 'index') {
                                displaySitemapSelection(response.data.sitemaps);
                            } else if (response.data.type === 'urls') {
                                populateTable(response.data.urls);
                                processQueue();
                            }
                        } else {
                            alert('Hata: ' + response.message);
                            resetUI();
                        }
                    })
                    .fail(function() {
                        alert('Sunucuya bağlanırken bir hata oluştu. Lütfen tekrar deneyin.');
                        resetUI();
                    })
                    .always(function() {
                        submitBtn.removeAttr('aria-busy').prop('disabled', false).text('Sitemap Kategorilerini Getir');
                    });
            });

            sitemapLinks.on('click', 'a', function(e) {
                e.preventDefault();


                resultsTbody.empty();
                processedUrls = 0;
                errorCount = 0;
                totalUrls = 0;
                $('#progress-title').text('Analiz İlerlemesi');
                updateProgress();

                const sitemapUrl = $(this).data('url');
                sitemapSelectionContainer.addClass('hidden');
                resultsContainer.removeClass('hidden');
                progressContainer.removeClass('hidden');

                $.post('{{ path("api_get_urls_from_sitemap") }}', { sitemap_url: sitemapUrl })
                    .done(function(response) {
                        if (response.success) {
                            populateTable(response.urls);
                        } else {
                            alert('Hata: ' + response.message);
                            resetUI();
                        }
                    })
                    .fail(function() {
                        alert('Seçilen sitemap yüklenirken bir hata oluştu.');
                        resetUI();
                    });
            });

            analyzeSelectedBtn.on('click', function() {
                const selectedSitemaps = sitemapLinks.find('input[type="checkbox"]:checked').map(function() {
                    return $(this).val();
                }).get();

                if (selectedSitemaps.length === 0) {
                    alert('Lütfen en az bir sitemap kategorisi seçin.');
                    return;
                }

                resetForAnalysis();
                sitemapSelectionContainer.addClass('hidden');
                progressContainer.removeClass('hidden');
                resultsContainer.removeClass('hidden');

                fetchAllUrls(selectedSitemaps);
            });

            function resetForAnalysis() {
                resultsTbody.empty();
                processedUrls = 0;
                errorCount = 0;
                totalUrls = 0;
                queue = [];
                activeRequests = 0;
                $('#progress-title').text('Analiz İlerlemesi');
                updateProgress();
            }

            function fetchAllUrls(sitemapUrls) {
                const promises = sitemapUrls.map(url => {
                    return $.post('{{ path("api_get_urls_from_sitemap") }}', { sitemap_url: url })
                        .then(function(response) {
                            if (response.success && response.urls) {
                                return response.urls;
                            }
                            return []; // Hata durumunda boş dizi döndür
                        })
                        .catch(function() {
                            return []; // AJAX hatasında boş dizi döndür
                        });
                });

                Promise.all(promises).then(urlArrays => {
                    const allUrls = [].concat.apply([], urlArrays);
                    const uniqueUrls = [...new Set(allUrls)];

                    if (uniqueUrls.length > 0) {
                        populateTable(uniqueUrls);
                    } else {
                        alert('Seçilen sitemap kategorilerinden hiç URL alınamadı.');
                        resetUI();
                    }
                });
            }

            function resetUI() {
                submitBtn.removeAttr('aria-busy').prop('disabled', false).text('Sitemap Kategorilerini Getir');
                progressContainer.addClass('hidden');
                resultsContainer.addClass('hidden');
                sitemapSelectionContainer.addClass('hidden');
                sitemapLinks.empty();
                resultsTbody.empty();
                totalUrls = processedUrls = errorCount = 0;
            }

            function displaySitemapSelection(sitemaps) {
                sitemapLinks.empty();
                sitemaps.forEach(url => {
                    const fileName = url.split('/').pop();
                    const checkbox = `
                        <div class="form-check submit-btn mb-24">
                            <input class="form-check-input ms-3" type="checkbox" value="${url}" id="sitemap-${fileName}">
                            <label class="form-check-label "
                                style="
                                    font-weight: 600;
                                    transition: background-color 0.3s ease, transform 0.2s ease;
                                    color: #ffffff;"
                                for="sitemap-${fileName}">
                                ${fileName}
                            </label>
                        </div>`;
                    sitemapLinks.append(checkbox);
                });
                analyzeSelectedBtn.removeClass('hidden');
                sitemapSelectionContainer.removeClass('hidden');
            }

            function populateTable(urls) {

                processedUrls = 0;
                errorCount = 0;
                $('#progress-title').text('Analiz İlerlemesi');

                totalUrls = urls.length;
                if (totalUrls === 0) {
                    alert('Site haritasında hiç URL bulunamadı.');
                    resetUI();
                    return;
                }

                urls.forEach(url => {
                    const row = `
                        <tr data-url="${url}" data-status="pending">
                        <td class="status" style="background-color: rgba(240, 244, 248, 1);"><div class="status-icon">⚪</div></td>
                        <td class="url" style="background-color: rgba(240, 244, 248, 1);"><a href="${url}" target="_blank" rel="noopener">${url}</a></td>
                        <td class="title" style="background-color: rgba(240, 244, 248, 1); color:#000000;"></td>
                        <td class="description" style="background-color: rgba(240, 244, 248, 1);color:#000000;"></td>
                        <td class="h1" style="background-color: rgba(240, 244, 248, 1); font-size:20px;color:#000000;"></td>
                        <td class="issues" style="background-color: rgba(240, 244, 248, 1);"></td>
                        </tr>`;
                    resultsTbody.append(row);
                });

                progressContainer.removeClass('hidden');
                resultsContainer.removeClass('hidden');
                updateProgress();
                queue = urls.slice();
                processQueue();
            }

            function processQueue() {
                while (activeRequests < CONCURRENT_REQUESTS && queue.length > 0) {
                    const url = queue.shift();
                    const nextRow = resultsTbody.find(`tr[data-url="${url}"]`);
                    if (nextRow.length) {
                        analyzeUrl(nextRow, url);
                    }
                }

                if (processedUrls === totalUrls) {
                    submitBtn.removeAttr('aria-busy').prop('disabled', false);
                    $('#progress-title').text(`Analiz Tamamlandı! (${totalUrls} sayfa analiz edildi!)`);
                }
            }

            function analyzeUrl(row, url) {
                activeRequests++;
                const statusIcon = row.find('.status .status-icon');

                statusIcon.html('<div class="loader"></div>');

                $.post('{{ path("api_analyze_url") }}', { url: url })
                    .done(function(response) {
                        if (response.success) {
                            updateRow(row, response.data);
                        } else {
                            updateRow(row, { issues: [response.message || 'Bilinmeyen hata'], status_ok: false });
                        }
                    })
                    .fail(function() {
                        updateRow(row, { issues: ['Sunucu yanıt vermedi veya hata oluştu.'], status_ok: false });
                    })
                    .always(function() {
                        processedUrls++;
                        activeRequests--;
                        updateProgress();
                        processQueue();
                    });
            }

            function updateRow(row, data) {
                const escapeHtml = text => $('<div>').text(text).html();

                row.find('.title').text(data.title || '');
                row.find('.description').text(data.description || '');
                row.find('.h1').text(data.h1 || '');

                const statusIcon = row.find('.status .status-icon');
                if (data.status_ok) {
                    statusIcon.html('✅').addClass('status-ok');
                    row.attr('data-status', 'processed');
                } else {
                    errorCount++;
                    statusIcon.html('❌').addClass('status-error');
                    row.attr('data-status', 'error');
                    const issuesHtml = '<ul>' + data.issues.map(issue => `<li>${escapeHtml(issue)}</li>`).join('') + '</ul>';
                    row.find('.issues').html(issuesHtml);
                }
            }

            function updateProgress() {
                const percent = totalUrls ? (processedUrls / totalUrls) * 100 : 0;
                progressBar.val(percent);
                progressText.text(`${processedUrls}/${totalUrls} URL analiz edildi.`);
            }
        });
    </script>
{% endblock %}
