{% block javascripts %}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        $(function() {
            const domainForm = $('#domain-form');
            const submitBtn = $('#submit-btn');
            const sitemapSelectionContainer = $('#sitemap-selection-container');
            const sitemapLinks = $('#sitemap-links');
            const progressContainer = $('#progress-container');
            const progressBar = $('#progress-bar');
            const progressText = $('#progress-text');
            const resultsContainer = $('#results-container');
            const resultsTbody = $('#results-tbody');
            const analyzeSelectedBtn = $('#analyze-selected-btn');
            const exportContainer = $('#export-container');
            const exportExcelBtn = $('#export-excel-btn');
            let totalUrls = 0, processedUrls = 0, errorCount = 0;
            const CONCURRENT_REQUESTS = 1;
            const DELAY_BETWEEN_REQUESTS = 250;
            let activeRequests = 0;
            let queue = [];

            const excelSvgIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-excel-fill" viewBox="0 0 16 16" style="vertical-align: text-bottom; margin-right: 5px;"><path d="M9.293 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.707A1 1 0 0 0 11 3.293L9.293 0zM9.5 3.5v-2l3 3h-2a1 1 0 0 1-1-1zM5.884 6.68 8 9.219l2.116-2.54a.5.5 0 1 1 .768.641L8.651 10l2.233 2.68a.5.5 0 0 1-.768.64L8 10.781l-2.116 2.54a.5.5 0 0 1-.768-.641L7.349 10 5.116 7.32a.5.5 0 1 1 .768-.64z"/></svg>';

            exportExcelBtn.on('click', function() {
                const rows = [];
                $('#results-tbody tr').each(function() {
                    const rowData = {};
                    rowData.url = $(this).find('a').attr('href') || $(this).text().trim();
                    rowData.title = $(this).find('.title').text().trim();
                    rowData.description = $(this).find('.description').text().trim();
                    rowData.h1 = $(this).find('.h1').text().trim();
                    rowData.issues = $(this).data('issues') || [];
                    rowData.status_ok = $(this).data('status') === 'processed';
                    rows.push(rowData);
                });

                if (rows.length === 0) {
                    alert('No analysis data found to export.');
                    return;
                }

                const domainName = $('#domain_url').val() || 'site';
                const loadingHtml = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="margin-right: 5px;"></span> Generating Excel...';

                exportExcelBtn.prop('disabled', true).html(loadingHtml);

                fetch('{{ path("app_export_excel") }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ data: rows, domain: domainName })
                })
                    .then(response => {
                        if (!response.ok) {
                            return response.json().then(err => { throw new Error(err.error || 'Server Error'); });
                        }
                        return response.blob();
                    })
                    .then(blob => {
                        const url = window.URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        const cleanDomain = domainName.replace(/[^a-z0-9]/gi, '-').toLowerCase();
                        a.download = cleanDomain + "-seo-report.xlsx";
                        document.body.appendChild(a);
                        a.click();
                        a.remove();
                        window.URL.revokeObjectURL(url);
                    })
                    .catch(error => {
                        console.error('Export Error:', error);
                        alert('Failed to download Excel: ' + error.message);
                    })
                    .finally(() => {
                        exportExcelBtn.prop('disabled', false).html(excelSvgIcon + ' Download Report as Excel');
                    });
            });

            domainForm.on('submit', function(e) {
                e.preventDefault();
                const domainUrl = $('#domain_url').val();

                if (!domainUrl) {
                    alert('Please enter a valid domain URL.');
                    return;
                }

                resetUI();
                submitBtn.attr('aria-busy', 'true').prop('disabled', true).text('Searching Sitemap...');

                $.post('{{ path("api_get_sitemaps") }}', { domain: domainUrl })
                    .done(function(response) {
                        if (response.success) {
                            if (response.data.type === 'index') {
                                displaySitemapSelection(response.data.sitemaps);
                            } else if (response.data.type === 'urls') {
                                populateTable(response.data.urls);
                            }
                        } else {
                            alert('Error: ' + response.message);
                            resetUI();
                        }
                    })
                    .fail(function() {
                        alert('Server connection error. Please try again.');
                        resetUI();
                    })
                    .always(function() {
                        submitBtn.removeAttr('aria-busy').prop('disabled', false).text('Get Sitemap Categories');
                    });
            });

            sitemapLinks.on('click', 'a', function(e) { e.preventDefault(); });

            analyzeSelectedBtn.on('click', function() {
                const selectedSitemaps = sitemapLinks.find('input[type="checkbox"]:checked').map(function() {
                    return $(this).val();
                }).get();

                if (selectedSitemaps.length === 0) {
                    alert('Please select at least one sitemap category.');
                    return;
                }

                resetForAnalysis();
                sitemapSelectionContainer.addClass('hidden');
                fetchAllUrls(selectedSitemaps);
            });

            function fetchAllUrls(sitemapUrls) {
                const promises = sitemapUrls.map(url => {
                    return $.post('{{ path("api_get_urls_from_sitemap") }}', { sitemap_url: url })
                        .then(function(response) {
                            return (response.success && response.urls) ? response.urls : [];
                        })
                        .catch(() => []);
                });

                Promise.all(promises).then(urlArrays => {
                    const allUrls = [].concat.apply([], urlArrays);
                    const uniqueUrls = [...new Set(allUrls)];

                    if (uniqueUrls.length > 0) {
                        populateTable(uniqueUrls);
                    } else {
                        alert('No URLs found in the selected sitemaps.');
                        resetUI();
                    }
                });
            }

            function resetUI() {
                progressContainer.addClass('hidden');
                resultsContainer.addClass('hidden');
                sitemapSelectionContainer.addClass('hidden');
                exportContainer.addClass('hidden');
                sitemapLinks.empty();
                resultsTbody.empty();
                totalUrls = processedUrls = errorCount = 0;
            }

            function resetForAnalysis() {
                resultsTbody.empty();
                processedUrls = 0;
                errorCount = 0;
                totalUrls = 0;
                queue = [];
                activeRequests = 0;
                $('#progress-title').text('Analysis Progress');
                progressBar.val(0);
                progressText.text('0/0 URLs analyzed.');
                progressContainer.removeClass('hidden');
                resultsContainer.removeClass('hidden');
                exportContainer.addClass('hidden');
            }

            function displaySitemapSelection(sitemaps) {
                sitemapLinks.empty();
                sitemaps.forEach(url => {
                    const fileName = url.split('/').pop();
                    const checkbox = `
                        <div class="form-check submit-btn mb-2 p-2 text-start">
                            <input class="form-check-input ms-2" type="checkbox" value="${url}" id="sitemap-${fileName}">
                            <label class="form-check-label ms-2 text-white" style="cursor:pointer;" for="sitemap-${fileName}">
                                ${fileName}
                            </label>
                        </div>`;
                    sitemapLinks.append(checkbox);
                });
                analyzeSelectedBtn.removeClass('hidden');
                sitemapSelectionContainer.removeClass('hidden');
            }

            function populateTable(urls) {
                resetForAnalysis();
                totalUrls = urls.length;
                updateProgress();
                urls.forEach(url => {
                    const row = `
                        <tr data-url="${url}" data-status="pending">
                            <td class="status"><div class="status-icon">⚪</div></td>
                            <td class="url"><a href="${url}" target="_blank" rel="noopener">${url}</a></td>
                            <td class="title"></td>
                            <td class="description"></td>
                            <td class="h1"></td>
                            <td class="issues"></td>
                        </tr>`;
                    resultsTbody.append(row);
                });
                queue = urls.slice();
                processQueue();
            }

            function processQueue() {
                if (activeRequests >= CONCURRENT_REQUESTS || queue.length === 0) return;
                const url = queue.shift();
                const nextRow = resultsTbody.find(`tr[data-url="${url}"]`);
                if (nextRow.length) analyzeUrl(nextRow, url);
                else processQueue();
            }

            function analyzeUrl(row, url) {
                activeRequests++;
                const statusIcon = row.find('.status .status-icon');
                statusIcon.html('<div class="loader"></div>');

                $.post('{{ path("api_analyze_url") }}', { url: url })
                    .done(function(response) {
                        if (response.success) updateRow(row, response.data);
                        else updateRow(row, { issues: [response.message || 'Unknown error'], status_ok: false });
                    })
                    .fail(function() {
                        updateRow(row, { issues: ['Connection failed'], status_ok: false });
                    })
                    .always(function() {
                        processedUrls++;
                        activeRequests--;
                        updateProgress();
                        if (queue.length > 0) setTimeout(processQueue, DELAY_BETWEEN_REQUESTS);
                        else if (activeRequests === 0) {
                            $('#progress-title').text(`Analysis Completed! (${totalUrls} analyzed, ${errorCount} issues found)`);
                            submitBtn.removeAttr('aria-busy').prop('disabled', false);
                            exportContainer.removeClass('hidden');
                        }
                    });
            }

            function updateRow(row, data) {
                row.find('.title').text(data.title || '');
                row.find('.description').text(data.description || '');
                row.find('.h1').text(data.h1 || '');
                row.data('issues', data.issues || []);

                const statusIcon = row.find('.status .status-icon');

                const issuesList = $('<ul>');
                let hasCritical = false;
                let hasWarning = false;

                if (data.issues && data.issues.length > 0) {
                    data.issues.forEach(issue => {
                        let liClass = '';
                        if (issue.includes('Critical')) {
                            liClass = 'issue-item-critical';
                            hasCritical = true;
                        } else if (issue.includes('Warning')) {
                            liClass = 'issue-item-warning';
                            hasWarning = true;
                        }

                        issuesList.append($('<li>').addClass(liClass).text(issue));
                    });
                    row.find('.issues').html(issuesList);
                }

                if (data.status_ok) {
                    statusIcon.html('✅');
                    row.attr('data-status', 'processed');
                } else {
                    errorCount++;
                    if (hasCritical) {
                        statusIcon.html('❌');
                        row.attr('data-status', 'critical');
                    } else if (hasWarning) {
                        statusIcon.html('⚠️');
                        row.attr('data-status', 'warning');
                    } else {
                        statusIcon.html('❌');
                        row.attr('data-status', 'critical');
                    }
                }
            }

            function updateProgress() {
                const percent = totalUrls ? (processedUrls / totalUrls) * 100 : 0;
                progressBar.val(percent);
                progressText.text(`${processedUrls}/${totalUrls} URLs analyzed.`);
            }
        });
    </script>
{% endblock %}
