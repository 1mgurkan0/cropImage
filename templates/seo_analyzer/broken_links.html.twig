{% block javascripts %}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
    $(function() {
        const form = $('#broken-link-form');
        const submitBtn = $('#submit-btn');
        const progressContainer = $('#progress-container');
        const progressBar = $('#progress-bar');
        const progressText = $('#progress-text');
        const resultsContainer = $('#results-container');
        const resultsTbody = $('#results-tbody');

        form.on('submit', function(e) {
            e.preventDefault();
            const url = $('#url_to_check').val();

            if (!url) {
                alert('Lütfen geçerli bir URL girin.');
                return;
            }

            submitBtn.attr('aria-busy', 'true').prop('disabled', true);
            resultsContainer.addClass('hidden');
            resultsTbody.empty();
            progressContainer.removeClass('hidden');
            progressText.text('Linkler taranıyor ve kontrol ediliyor, lütfen bekleyin...');

            $.post("{{ path('api_find_broken_links') }}", { url: url })
                .done(function(response) {
                    if (response.success) {
                        displayResults(response.data);
                    } else {
                        alert('Hata: ' + response.message);
                    }
                })
                .fail(function() {
                    alert('Sunucuya bağlanırken bir hata oluştu.');
                })
                .always(function() {
                    submitBtn.removeAttr('aria-busy').prop('disabled', false);
                    progressContainer.addClass('hidden');
                });
        });

        function displayResults(links) {
            resultsContainer.removeClass('hidden');
            if (links.length === 0) {
                resultsTbody.append('<tr><td colspan="3">Sayfada hiç kırık link bulunamadı.</td></tr>');
                return;
            }

            links.forEach(link => {
                const row = `
                    <tr>
                        <td><a href="${link.url}" target="_blank">${link.url}</a></td>
                        <td>${link.http_code}</td>
                        <td><span class="status-error">Kırık</span></td>
                    </tr>
                `;
                resultsTbody.append(row);
            });
        }
    });
    </script>
{% endblock %}
