<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Görsel Kırp</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #4a90e2;
            --background-color: #f0f4f8;
            --card-bg-color: #ffffff;
            --text-color: #34495e;
            --secondary-text-color: #7f8c8d;
            --border-color: #e0e6ed;
            --shadow-light: 0 4px 15px rgba(0, 0, 0, 0.05);
            --shadow-hover: 0 8px 25px rgba(0, 0, 0, 0.1);
        }
        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--background-color);
            color: var(--text-color);
        }
        .converter-card {
            background-color: var(--card-bg-color);
            border-radius: 24px;
            box-shadow: var(--shadow-light);
            padding: 2.5rem;
            border: none;
        }
        .card-title {
            font-weight: 700;
            color: var(--text-color);
            margin-bottom: 0.5rem;
        }
        .intro-text {
            color: var(--secondary-text-color);
            font-size: 1rem;
            line-height: 1.6;
        }
        .intro-text li {
            margin-bottom: 0.5rem;
        }
        .file-upload-area {
            border: 2px dashed var(--border-color);
            border-radius: 16px;
            transition: border-color 0.3s ease, background-color 0.3s ease;
            cursor: pointer;
            padding: 2.5rem 1.5rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        .file-upload-area.highlight {
            border-color: var(--primary-color);
            background-color: #f1f6ff;
        }
        .file-upload-btn, .submit-btn {
            background-color: var(--primary-color);
            border: none;
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 600;
            transition: background-color 0.3s ease, transform 0.2s ease;
            color: white; /* Ensure text color is white for buttons */
        }
        .file-upload-btn:hover, .submit-btn:hover {
            background-color: #3871c2;
            transform: translateY(-2px);
        }
        .form-select {
            border-radius: 12px;
            border: 1px solid var(--border-color);
            padding: 10px 15px;
            transition: border-color 0.3s ease;
        }
        .form-select:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.25rem rgba(74, 144, 226, 0.25);
        }
        .form-label {
            font-weight: 600;
            color: var(--text-color);
            margin-bottom: 0.5rem;
        }
        .preview-container {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-top: 20px;
            justify-content: center;
        }
        .preview-item {
            position: relative;
            width: 80px;
            height: 80px;
            border-radius: 12px;
            overflow: hidden;
            border: 2px solid var(--border-color);
        }
        .preview-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .remove-btn {
            position: absolute;
            top: -8px;
            right: -8px;
            background-color: #e74c3c;
            color: white;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            font-size: 16px;
            font-weight: bold;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
            transition: transform 0.2s ease;
        }
        .remove-btn:hover {
            transform: scale(1.1);
        }
        .feature-card {
            background-color: var(--card-bg-color);
            border-radius: 24px;
            box-shadow: var(--shadow-light);
            transition: transform 0.3s, box-shadow 0.3s;
            text-decoration: none;
            border: none;
        }
        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow-hover);
        }
        .card-icon svg {
            width: 64px;
            height: 64px;
            fill: var(--primary-color);
        }
        .card-title-link {
            font-weight: 600;
            color: var(--text-color);
            text-decoration: none;
        }
        .card-text {
            color: var(--secondary-text-color);
        }

        #cropper-preview {
            max-width: 100%;
            display: block;
            margin-bottom: 20px;
        }
        .img-container {
            max-width: 100%;
            overflow: hidden;
            margin-top: 20px;
            margin-bottom: 20px;
            display: none;
        }
    </style>
</head>
<body>
<div class="container my-5 ">
    <div class="card p-4 shadow-lg converter-card">
        <form id="cropForm" method="POST" action="{{ path('app_image_crop') }}">
            <h1 class="card-title text-center mb-4">Görsel Kırp</h1>

            <ul class="intro-text lead mb-5 text-start">
                <li>Kırpmak istediğiniz görseli seçin.</li>
                <li>Görseli dilediğiniz gibi kırpın ve indirin.</li>
            </ul>

            <div class="mb-3">
                <label for="imageInput" class="form-label fw-bold text-muted">Görsel Seç</label>
                <div id="drop-area-crop" class="file-upload-area p-5 text-center">
                    <span class="text-muted d-block mb-2">Dosyayı buraya sürükleyin</span>
                    <label for="imageInput" class="btn btn-primary file-upload-btn">Dosya Seç</label>
                    <input type="file" id="imageInput" accept="image/*" class="d-none" required>
                </div>
            </div>

            <div class="img-container" style="width: 500px; height: 400px; margin: 0 auto; text-align: center;">
                <img id="cropper-preview" src="" alt="Image Preview" style="width: 600px; height: 600px;">
            </div>

            <input type="hidden" name="croppedImage" id="croppedImage">
            <button type="submit" class="btn btn-primary w-100 mt-3 submit-btn">Kırp ve İndir</button>
        </form>
    </div>
</div>

<div class="container main-container text-center py-1">
    <div class="row g-4">
        <div class="col-md-6">
            <a href="{{ path('app_image_compress') }}" class="text-decoration-none">
                <div class="card p-5 feature-card h-100 d-flex flex-column align-items-center justify-content-center">
                    <span class="card-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-arrows-collapse" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h13a.5.5 0 0 1 0 1h-13A.5.5 0 0 1 1 8m13-3.5a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1 0-1h13a.5.5 0 0 1 .5.5m-13 7a.5.5 0 0 1 .5-.5h13a.5.5 0 0 1 0 1h-13a.5.5 0 0 1-.5-.5"/>
                        </svg>
                    </span>
                    <h2 class="card-title-link mt-3">Görsel Sıkıştırma</h2>
                    <p class="card-text text-center mt-2">Dosya boyutunu düşürerek hız kazanın. Kaliteyi korurken sıkıştırın.</p>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a href="{{ path('app_image_convert') }}" class="text-decoration-none">
                <div class="card p-5 feature-card h-100 d-flex flex-column align-items-center justify-content-center">
                    <span class="card-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-arrow-repeat" viewBox="0 0 16 16">
                            <path d="M11.534 7h3.932a.25.25 0 0 1 .192.41l-1.92 2.9A.25.25 0 0 1 13.52 10.5h-3.932a.25.25 0 0 1-.192-.41l1.92-2.9a.25.25 0 0 1 .192-.09m-7.068 0h3.932a.25.25 0 0 0 .192-.41L6.48 4.6A.25.25 0 0 0 6.48 4.6L4.56 1.7A.25.25 0 0 0 4.368 1.5h-3.932a.25.25 0 0 0-.192.41l1.92 2.9a.25.25 0 0 0-.192.41L1.76 10.5a.25.25 0 0 0 .192.41h3.932a.25.25 0 0 0 .192-.41l-1.92-2.9a.25.25 0 0 0-.192-.09m7.068 0h3.932a.25.25 0 0 0 .192-.41L13.52 4.6A.25.25 0 0 0 13.52 4.6L11.6 1.7A.25.25 0 0 0 11.408 1.5h-3.932a.25.25 0 0 0-.192.41l1.92 2.9a.25.25 0 0 0-.192.41L7.76 10.5a.25.25 0 0 0 .192.41h3.932a.25.25 0 0 0 .192-.41l-1.92-2.9a.25.25 0 0 0-.192-.09m-7.068 0h3.932a.25.25 0 0 0 .192-.41L6.48 4.6A.25.25 0 0 0 6.48 4.6L4.56 1.7A.25.25 0 0 0 4.368 1.5h-3.932a.25.25 0 0 0-.192.41l1.92 2.9a.25.25 0 0 0-.192.41L1.76 10.5a.25.25 0 0 0 .192.41h3.932a.25.25 0 0 0 .192-.41l-1.92-2.9a.25.25 0 0 0-.192-.09"/>
                        </svg>
                    </span>
                    <h2 class="card-title-link mt-3">Görsel Dönüştürme</h2>
                    <p class="card-text text-center mt-2">Farklı formatlara hızlı ve kolay dönüştürme.</p>
                </div>
            </a>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    let cropper;
    const imageInput = document.getElementById('imageInput');
    const cropperPreview = document.getElementById('cropper-preview');
    const croppedImageInput = document.getElementById('croppedImage');
    const form = document.getElementById('cropForm');
    const dropAreaCrop = document.getElementById('drop-area-crop');
    const imgContainer = document.querySelector('.img-container');

    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        dropAreaCrop.addEventListener(eventName, preventDefaults, false);
    });

    function preventDefaults(e) {
        e.preventDefault();
        e.stopPropagation();
    }

    ['dragenter', 'dragover'].forEach(eventName => {
        dropAreaCrop.addEventListener(eventName, () => dropAreaCrop.classList.add('highlight'), false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
        dropAreaCrop.addEventListener(eventName, () => dropAreaCrop.classList.remove('highlight'), false);
    });

    dropAreaCrop.addEventListener('drop', handleDrop, false);

    function handleDrop(e) {
        const dt = e.dataTransfer;
        const files = dt.files;
        handleFiles(files);
    }

    imageInput.addEventListener('change', function () {
        handleFiles(this.files);
    });

    function handleFiles(files) {
        const file = files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                cropperPreview.src = e.target.result;
                imgContainer.style.display = 'block';

                if (cropper) {
                    cropper.destroy();
                }

                cropper = new Cropper(cropperPreview, {
                    aspectRatio: NaN,
                    viewMode: 1,
                    responsive: true,
                    autoCropArea: 1
                });
            };
            reader.readAsDataURL(file);
        }
    }

    form.addEventListener('submit', function (e) {
        e.preventDefault();

        if (cropper) {
            const canvas = cropper.getCroppedCanvas();
            croppedImageInput.value = canvas.toDataURL('image/jpeg');

            form.submit();
        } else {
            alert('Lütfen önce bir görsel seçin ve kırpma alanını ayarlayın.');
        }
    });
</script>
</body>
</html>
