{% block stylesheets %}
    <title>SEO Analyzer</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #5d67e6;
            --background-color: #f0f4f8;
            --card-bg-color: #ffffff;
            --text-color: #1a2a4b;
            --secondary-text-color: #6c757d;
            --border-color: #e0e6ed;
            --shadow-light: 0 4px 15px rgba(0, 0, 0, 0.05);
            --shadow-hover: 0 8px 25px rgba(0, 0, 0, 0.1);
            --status-critical-bg: rgba(220, 53, 69, 0.1);
            --status-warning-bg: rgba(255, 193, 7, 0.15);
            --status-success-bg: rgba(40, 167, 69, 0.1);
            --text-critical: #dc3545;
            --text-warning: #b45309;
            --text-success: #198754;
        }
        html,body {
            height: 100%;
            background-color: var(--background-color);
            padding-top: 1rem;
            padding-bottom: 2rem;
        }
        .hidden {
            display: none !important;
        }
        #progress-container {
            margin-top: 1.5rem;
        }
        #results-container table {
            table-layout: fixed;
            background-color: var(--card-bg-color);
        }
        #results-container th, #results-container td {
            word-wrap: break-word;
            color: #000000;
            border-color: var(--border-color);
            font-size:15px;
            vertical-align: top;
            padding: 12px;
        }
        #results-container th {
            background-color: var(--primary-color);
            color: #ffffff;
        }
        #results-container td.status {
            width: 70px;
            text-align: center;
            vertical-align: top;
            font-size: 1.2rem;
        }
        #results-container td.url {
            width: 25%;
        }

        #results-container td.issues ul {
            margin: 0;
            padding-left: 1.2rem;
        }
        #results-container td.issues ul li {
            position: relative;
            margin-bottom: 4px;
            font-size: 0.9em;
            line-height: 1.4;
        }

        .issue-item-critical {
            color: var(--text-critical);
            font-weight: 600;
        }
        .issue-item-critical::before {
            color: var(--text-critical);
            font-weight: bold;
            display: inline-block;
            width: 1em;
            margin-left: -1em;
        }

        .issue-item-warning {
            color: var(--text-warning);
        }
        .issue-item-warning::before {
            color: var(--text-warning);
            font-weight: bold;
            display: inline-block;
            width: 1em;
            margin-left: -1em;
        }

        .loader {
            display: inline-block;
            width: 1rem;
            height: 1rem;
            border: 2px solid var(--primary-color);
            border-right-color: transparent;
            border-radius: 50%;
            animation: spin .75s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        tr[data-status="processed"] {
            background-color: var(--status-success-bg);
        }
        tr[data-status="critical"] {
            background-color: var(--status-critical-bg);
        }
        tr[data-status="warning"] {
            background-color: var(--status-warning-bg);
        }

        h1, h2, h3 {
            color: var(--text-color);
        }
        small, label {
            color: #000000;
        }
        a {
            color: var(--primary-color);
            text-decoration: none;
        }
        a:hover {
            color: #3871c2;
            text-decoration: underline;
        }

        .converter-card {
            background-color: var(--card-bg-color);
            border-radius: 24px;
            box-shadow: var(--shadow-light);
            padding: 2.5rem;
            border: none;
        }
        .feature-card {
            background-color: var(--card-bg-color);
            border-radius: 20px;
            border: none;
            box-shadow: var(--shadow-light);
            transition: transform 0.3s, box-shadow 0.3s;
            cursor: pointer;
            text-decoration: none;
            height: 100%;
        }
        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow-hover);
        }
        .card-icon {
            font-size: 3rem;
            color: var(--primary-color);
            margin-bottom: 1rem;
        }
        .card-title-link {
            font-weight: 600;
            color: var(--text-color);
            text-decoration: none;
        }
        .card-text {
            color: var(--secondary-text-color);
        }
        .submit-btn {
            background-color: var(--primary-color);
            border: none;
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 600;
            transition: background-color 0.3s ease, transform 0.2s ease;
            color: #ffffff;
            width: 100%;
        }
        .submit-btn:hover {
            background-color: #3871c2;
            transform: translateY(-2px);
        }
        .submit-btn:disabled {
            background-color: #a0a0a0;
            cursor: not-allowed;
            transform: none;
        }

        #sitemap-selection-container {
            margin-top: 1.5rem;
            padding: 1.5rem;
            background-color: var(--background-color);
            border-radius: 10px;
            border: 1px solid var(--border-color);
        }
        #sitemap-links .form-check {
            background-color: var(--primary-color);
            border-radius: 8px;
            margin-bottom: 10px;
            padding: 10px 15px;
        }
        #export-excel-btn {
            background-color: #217346 !important;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            max-width: 300px;
        }
        #export-excel-btn:hover {
            background-color: #1a5c38 !important;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="container">
        <div class="card p-4 shadow-lg converter-card">
            <hgroup class="mb-4">
                <h1 class="mb-2">Async SEO Analysis Tool</h1>
                <h2>Analyze pages in the sitemap in real-time.</h2>
            </hgroup>

            <form id="domain-form" style="background-color: var(--card-bg-color); border-radius: 10px; padding: 1.5rem; box-shadow: var(--shadow-light); border: 1px solid var(--border-color);">
                <label for="domain_url" class="form-label fw-bold">Domain URL</label>
                <input type="url" id="domain_url" name="domain_url" class="form-control mb-2" placeholder="https://example.com" required style="background-color: #fff; color: #000;">
                <small class="text-muted d-block mt-3 mb-3">Please enter the main domain address. The system will automatically find the sitemap from robots.txt.</small>
                <button type="submit" id="submit-btn" class="submit-btn">Get Sitemap Categories</button>
            </form>

            <div id="sitemap-selection-container" class="hidden mt-4">
                <h4 class="mb-3">Select Sitemap Category to Analyze</h4>
                <div class="row">
                    <div class="col-12" id="sitemap-links"></div>
                </div>
                <button id="analyze-selected-btn" class="submit-btn mt-3">Analyze Selected</button>
            </div>

            <div id="progress-container" class="hidden">
                <h3 id="progress-title">Analysis Progress</h3>
                <progress id="progress-bar" value="0" max="100" class="w-100"></progress>
                <p id="progress-text" class="text-dark fw-bold">0/0 URLs analyzed.</p>
            </div>

            <div id="export-container" class="hidden mt-4 text-center">
                <button id="export-excel-btn" class="submit-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-excel-fill" viewBox="0 0 16 16">
                        <path d="M9.293 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.707A1 1 0 0 0 11 3.293L9.293 0zM9.5 3.5v-2l3 3h-2a1 1 0 0 1-1-1zM5.884 6.68 8 9.219l2.116-2.54a.5.5 0 1 1 .768.641L8.651 10l2.233 2.68a.5.5 0 0 1-.768.64L8 10.781l-2.116 2.54a.5.5 0 0 1-.768-.641L7.349 10 5.116 7.32a.5.5 0 1 1 .768-.64z"/>
                    </svg>
                    Download Report as Excel
                </button>
            </div>

            <div id="results-container" class="hidden mt-4">
                <hr>
                <h3>Analysis Results</h3>
                <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                    <table class="table table-bordered">
                        <thead style="position: sticky; top: 0; z-index: 1;">
                        <tr>
                            <th class="status">Status</th>
                            <th class="url">URL</th>
                            <th>Title</th>
                            <th>Description</th>
                            <th>H1</th>
                            <th>Issues Found</th>
                        </tr>
                        </thead>
                        <tbody id="results-tbody"></tbody>
                    </table>
                </div>
            </div>

        </div>
    </main>

    <div class="container main-container text-center py-5">
        <div class="row g-4">
            <div class="col-md-4">
                <a href="{{ path('app_image_compress') }}" class="text-decoration-none">
                    <div class="card p-4 feature-card d-flex flex-column align-items-center justify-content-center">
                        <span class="card-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-arrows-collapse" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h13a.5.5 1 0 0 1 0 1h-13A.5.5 0 0 1 1 8m13-3.5a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1 0-1h13a.5.5 0 0 1 .5.5m-13 7a.5.5 0 0 1 .5-.5h13a.5.5 0 0 1 0 1h-13a.5.5 0 0 1-.5-.5"/></svg>
