{% block stylesheets %}
    <title>Seo Analizcisi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #5d67e6;
            --background-color: #f0f4f8;
            --card-bg-color: #ffffff;
            --text-color: #1a2a4b;
            --secondary-text-color: #6c757d;
            --border-color: #e0e6ed;
            --shadow-light: 0 4px 15px rgba(0, 0, 0, 0.05);
            --shadow-hover: 0 8px 25px rgba(0, 0, 0, 0.1);
        }
        html,body {
            height: 100%;
            background-color: var(--background-color);
            padding-top: 1rem;
            padding-bottom: 2rem;
        }
        .hidden {
            display: none;
        }
        #progress-container {
            margin-top: 1.5rem;
        }
        #results-container table {
            table-layout: fixed;
            background-color: var(--card-bg-color);
        }
        #results-container th, #results-container td {
            word-wrap: break-word;
            color: #FFFFFF;
            border-color: var(--border-color);
        }
        #results-container th {
            background-color: var(--primary-color);
        }
        #results-container td.status {
            width: 40px;
            text-align: center;
        }
        #results-container td.url {
            width: 25%;
        }
        #results-container td.issues ul {
            margin: 0;
            padding-left: 1rem;
        }
        #results-container td.issues ul li {
            color: #000000;
            text-decoration: underline;
        }
        .status-icon {
            font-size: 1.2rem;
            color: var(--primary-color);
        }
        .status .loader {
            display: inline-block;
            width: 1rem;
            height: 1rem;
            border: 2px solid currentColor;
            border-right-color: transparent;
            border-radius: 50%;
            animation: spin .75s linear infinite;
            color: var(--primary-color);
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        tr[data-status="processed"] {
            background-color: rgba(68, 189, 133, 0.08);
        }
        tr[data-status="error"] {
            background-color: rgba(239, 93, 93, 0.1);
        }
        .status-ok {
            color: #44bd85; /* Green checkmark */
        }
        .status-error {
            color: #ef5d5d; /* Red cross */
        }
        h1, h2, h3 {
            color: var(--text-color);
        }
        small, label {
            color: #000000;
        }
        a {
            color: var(--primary-color);
        }
        a:hover {
            color: #3871c2; /* Darker primary color on hover */
        }

        .converter-card {
            background-color: var(--card-bg-color);
            border-radius: 24px;
            box-shadow: var(--shadow-light);
            padding: 2.5rem;
            border: none;
        }
        .card-title {
            font-weight: 700;
            color: var(--text-color);
            margin-bottom: 0.5rem;
        }
        .feature-card {
            background-color: var(--card-bg-color);
            border-radius: 20px;
            border: none;
            box-shadow: var(--shadow-light);
            transition: transform 0.3s, box-shadow 0.3s;
            cursor: pointer;
            text-decoration: none;
        }
        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow-hover);
        }
        .card-icon {
            font-size: 3rem;
            color: var(--primary-color);
            margin-bottom: 1rem;
        }
        .card-title-link {
            font-weight: 600;
            color: var(--text-color);
            text-decoration: none;
        }
        .card-text {
            color: var(--secondary-text-color);
        }
        .submit-btn {
            background-color: var(--primary-color);
            border: none;
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 600;
            transition: background-color 0.3s ease, transform 0.2s ease;
            color: #ffffff;
        }
        .submit-btn:hover {
            background-color: #3871c2;
            transform: translateY(-2px);
        }

        #sitemap-selection-container {
            margin-top: 1.5rem;
            padding: 1.5rem;
            background-color: var(--background-color);
            border-radius: 10px;
            border: 1px solid var(--border-color);
        }

        #sitemap-selection-container h4 {
            color: var(--text-color);
            margin-bottom: 1rem;
        }

        #sitemap-selection-container .row .col {
            background-color: var(--card-bg-color);
            border-radius: 10px;
            padding: 1rem;
            box-shadow: var(--shadow-light);
            border: 1px solid var(--border-color);
        }

        #sitemap-links a {
            display: inline-block;
            background-color: var(--primary-color);
            color: #ffffff;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            text-decoration: none;
            transition: background-color 0.3s ease;
            margin-right: 10px;
            margin-bottom: 10px;
        }

        #sitemap-links a:hover {
            background-color: #3871c2;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="container">
        <div class="card p-4 shadow-lg converter-card">
            <hgroup>
                <h1>Asenkron SEO Analiz Aracı</h1>
                <h2>Sitemap'teki sayfaları anlık olarak analiz edin.</h2>
            </hgroup>

            <form id="domain-form" style="
            background-color: var(--card-bg-color);
            border-radius: 10px;
            padding: 1rem;
            box-shadow: var(--shadow-light);
            border: 1px solid var(--border-color);">
                <label for="domain_url">Domain URL</label>
                <input type="url" id="domain_url" name="domain_url" placeholder="https://example.com" style="background-color: var(--card-bg-color); color:#000000" required >
                <small>Lütfen analiz edilecek sitenin ana domain adresini girin. Sistem robots.txt dosyasından sitemap'i otomatik bulacaktır.</small>
                <button type="submit" id="submit-btn" class="submit-btn">Sitemap Kategorilerini Getir</button>
            </form>

            <div id="sitemap-selection-container" class="hidden ms-3 me-3 ">
                <h4>Analiz Edilecek Sitemap Kategorisini Seçin</h4>
                <div class="row">
                    <div class="col py-3 px-3" id="sitemap-links"></div>
                </div>
                <button id="analyze-selected-btn" class="submit-btn hidden mt-3">Seçilenleri Analiz Et</button>
            </div>

            <div id="progress-container" class="hidden" >
                <h3 id="progress-title">Analiz İlerlemesi</h3>
                <progress id="progress-bar" value="0" max="100"></progress>
                <p id="progress-text" class="text-black">0/0 URL analiz edildi.</p>
            </div>

            <div id="results-container" class="hidden " >
                <hr>
                <h3>Analiz Sonuçları</h3>
                <div class="overflow-auto">
                    <table>
                        <thead>
                        <tr>
                            <th class="status">Durum</th>
                            <th class="url">URL</th>
                            <th>Title</th>
                            <th>Description</th>
                            <th>H1</th>
                            <th>Bulunan Sorunlar</th>
                        </tr>
                        </thead>
                        <tbody id="results-tbody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

