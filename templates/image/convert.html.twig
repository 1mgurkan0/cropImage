<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Image Converter</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #4a90e2;
            --background-color: #f0f4f8;
            --card-bg-color: #ffffff;
            --text-color: #34495e;
            --secondary-text-color: #7f8c8d;
            --border-color: #e0e6ed;
            --shadow-light: 0 4px 15px rgba(0, 0, 0, 0.05);
            --shadow-hover: 0 8px 25px rgba(0, 0, 0, 0.1);
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--background-color);
            color: var(--text-color);
        }
        .converter-card {
            background-color: var(--card-bg-color);
            border-radius: 24px;
            box-shadow: var(--shadow-light);
            padding: 2.5rem;
            border: none;
        }
        .card-title {
            font-weight: 700;
            color: var(--text-color);
            margin-bottom: 0.5rem;
        }
        .intro-text {
            color: var(--secondary-text-color);
            font-size: 1rem;
            line-height: 1.6;
        }
        .intro-text li {
            margin-bottom: 0.5rem;
        }
        .file-upload-area {
            border: 2px dashed var(--border-color);
            border-radius: 16px;
            transition: border-color 0.3s ease, background-color 0.3s ease;
            cursor: pointer;
            padding: 2.5rem 1.5rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        .file-upload-area.highlight {
            border-color: var(--primary-color);
            background-color: #f1f6ff;
        }
        .file-upload-btn, .submit-btn {
            background-color: #5d67e6;
            border: none;
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 600;
            transition: background-color 0.3s ease, transform 0.2s ease;
        }
        .file-upload-btn:hover, .submit-btn:hover {
            background-color: #3871c2;
            transform: translateY(-2px);
        }
        .form-select {
            border-radius: 12px;
            border: 1px solid var(--border-color);
            padding: 10px 15px;
            transition: border-color 0.3s ease;
        }
        .form-select:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.25rem rgba(74, 144, 226, 0.25);
        }
        .form-label {
            font-weight: 600;
            color: var(--text-color);
            margin-bottom: 0.5rem;
        }
        .preview-container {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-top: 20px;
            justify-content: center;
        }
        .preview-item {
            position: relative;
            width: 80px;
            height: 80px;
            border-radius: 12px;
            overflow: hidden;
            border: 2px solid var(--border-color);
        }
        .preview-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .remove-btn {
            position: absolute;
            top: 5px;
            right: 5px;
            background-color: #e74c3c;
            color: white;
            border-radius: 50%;
            width: 18px;
            height: 18px;
            font-size: 14px;
            font-weight: bold;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
            transition: transform 0.2s ease;
        }
        .remove-btn:hover {
            transform: scale(1.1);
        }
        .feature-card {
            background-color: var(--card-bg-color);
            border-radius: 24px;
            box-shadow: var(--shadow-light);
            transition: transform 0.3s, box-shadow 0.3s;
            text-decoration: none;
            border: none;
        }
        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow-hover);
        }
        .card-icon svg {
            width: 64px;
            height: 64px;
            color: #5d67e6;
        }
        .card-title-link {
            font-weight: 600;
            color: var(--text-color);
            text-decoration: none;
        }
        .card-text {
            color: var(--secondary-text-color);
        }
    </style>
</head>
<body>
<div class="container my-5">
    <div class="card p-4 shadow-lg converter-card">
        <form method="POST" action="{{ path('app_image_convert') }}" enctype="multipart/form-data">
            <h1 class="card-title text-center mb-4">Image Converter</h1>

            <div class="mb-3">
                <label for="image-upload" class="form-label fw-bold text-muted">Select Images (Multiple)</label>
                <div id="drop-area" class="file-upload-area p-5 text-center">
                    <span class="text-muted d-block mb-2">Drag files here or</span>
                    <label for="image-upload" class="btn btn-primary file-upload-btn">Choose File</label>
                    <input type="file" id="image-upload" name="images[]" class="d-none" multiple required>
                </div>
            </div>

            <div id="preview-container" class="preview-container"></div>

            <div class="mb-3">
                <label for="format-select" class="form-label fw-bold text-muted">Target Format</label>
                <select id="format-select" name="format" class="form-select" required>
                    <option value="webp">WEBP</option>
                    <option value="jpeg">JPEG</option>
                    <option value="png">PNG</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary w-100 mt-3 submit-btn">Convert and Download</button>
        </form>
    </div>
</div>

<div class="container main-container text-center py-1">
    <div class="row g-4">
        <div class="col-md-4">
            <a href="{{ path('app_image_compress') }}" class="text-decoration-none">
                <div class="card p-5 feature-card h-100 d-flex flex-column align-items-center justify-content-center">
                    <span class="card-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-arrows-collapse" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h13a.5.5 1 0 0 1 0 1h-13A.5.5 0 0 1 1 8..." />
                        </svg>
                    </span>
                    <h2 class="card-title-link mt-3">Image Compression</h2>
                    <p class="card-text text-center mt-2">Gain speed by reducing file size. Compress while maintaining quality.</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="{{ path('app_image_crop') }}" class="text-decoration-none">
                <div class="card p-5 feature-card h-100 d-flex flex-column align-items-center justify-content-center">
                    <span class="card-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-arrow-repeat" viewBox="0 0 16 16">
                            <path d="M11.534 7h3.932a.25.25 0 0 1 .192.41l-1.92 2.9A.25.25 0 0 1 13.52 10.5h-3.932a.25.25 0 0 1-.192-.41l1.92-2.9a.25.25 0 0 1 .192-.09m-7.068 0h3.932a.25.25 0 0 0 .192-.41L6.48 4.6A.25.25 0 0 0 6.48 4.6L4.56 1.7A.25.25 0 0 0 4.368 1.5h-3.932a.25.25 0 0 0-.192.41l1.92 2.9a.25.25 0 0 0-.192.41L1.76 10.5a.25.25 0 0 0 .192.41h3.932a.25.25 0 0 0 .192-.41l-1.92-2.9a.25.25 0 0 0-.192-.09m7.068 0h3.932a.25.25 0 0 0 .192-.41L13.52 4.6A.25.25 0 0 0 13.52 4.6L11.6 1.7A.25.25 0 0 0 11.408 1.5h-3.932a.25.25 0 0 0-.192.41l1.92 2.9a.25.25 0 0 0-.192.41L7.76 10.5a.25.25 0 0 0 .192.41h3.932a.25.25 0 0 0 .192-.41l-1.92-2.9a.25.25 0 0 0-.192-.09m-7.068 0h3.932a.25.25 0 0 0 .192-.41L6.48 4.6A.25.25 0 0 0 6.48 4.6L4.56 1.7A.25.25 0 0 0 4.368 1.5h-3.932a.25.25 0 0 0-.192.41l1.92 2.9a.25.25 0 0 0-.192.41L1.76 10.5a.25.25 0 0 0 .192.41h3.932a.25.25 0 0 0 .192-.41l-1.92-2.9a.25.25 0 0 0-.192-.09"/>
                        </svg>
                    </span>
                    <h2 class="card-title-link mt-3">Image Cropper</h2>
                    <p class="card-text text-center mt-2">Highlight the area you want. Crop out unnecessary details and simplify.</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="{{ path('seo_analyzer') }}" class="text-decoration-none">
                <div class="card p-5 feature-card h-100 d-flex flex-column align-items-center justify-content-center">
                    <span class="card-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
                        </svg>
                    </span>
                    <h2 class="card-title-link mt-3 text-center">SEO Analyzer</h2>
                    <p class="card-text text-center mt-2">Instantly analyze your website's SEO performance. See your shortcomings and discover opportunities for improvement!</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="{{ path('broken_link_checker') }}" class="text-decoration-none">
                <div class="card p-5 feature-card h-100 d-flex flex-column align-items-center justify-content-center">
                    <span class="card-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-link-45deg" viewBox="0 0 16 16">
                            <path d="M4.715 6.542 3.343 7.914a3 3 0 1 0 4.243 4.243l1.828-1.829A3 3 0 0 0 8.586 5.5L8 6.086a1.002 1.002 0 0 0-.154.199 2 2 0 0 1 .861 3.337L6.88 11.45a2 2 0 1 1-2.83-2.83l.793-.792a4.018 4.018 0 0 1-.128-1.287z"/>
                            <path d="M6.586 4.672A3 3 0 0 0 7.414 9.5l.775-.776a2 2 0 0 1-.896-3.346L9.12 3.55a2 2 0 1 1 2.83 2.83l-.793.792c.112.42.155.855.128 1.287l1.372-1.372a3 3 0 1 0-4.243-4.243z"/>
                        </svg>
                    </span>
                    <h2 class="card-title-link mt-3 text-center">Broken Link Checker</h2>
                    <p class="card-text text-center mt-2">Find 404s and other broken links on a page.</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="{{ path('app_character_counter') }}" class="text-decoration-none">
                <div class="card p-5 feature-card h-100 d-flex flex-column align-items-center justify-content-center">
            <span class="card-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-journal-text" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M5 8h6v1H5V8zm0-2h6v1H5V6z"/>
                    <path d="M3 2.5v11a.5.5 0 0 0 .5.5H13v1H3.5A1.5 1.5 0 0 1 2 13.5v-11A1.5 1.5 0 0 1 3.5 1H13v1H3.5a.5.5 0 0 0-.5.5z"/>
                    <path d="M14 1.5a.5.5 0 0 1 .5.5v13a.5.5 0 0 1-1 0v-13a.5.5 0 0 1 .5-.5z"/>
                </svg>
            </span>
                    <h2 class="card-title-link mt-3 text-center">Text Counter</h2>
                    <p class="card-text text-center mt-2">Easily find out the number of characters and words in the text you enter.</p>
                </div>
            </a>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const dropArea = document.getElementById('drop-area');
        const fileInput = document.getElementById('image-upload');
        const previewContainer = document.getElementById('preview-container');

        let fileList = [];

        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropArea.addEventListener(eventName, preventDefaults, false);
        });
        ['dragenter', 'dragover'].forEach(eventName => {
            dropArea.addEventListener(eventName, () => dropArea.classList.add('highlight'), false);
        });
        ['dragleave', 'drop'].forEach(eventName => {
            dropArea.addEventListener(eventName, () => dropArea.classList.remove('highlight'), false);
        });

        dropArea.addEventListener('drop', handleDrop, false);
        fileInput.addEventListener('change', handleFiles, false);

        previewContainer.addEventListener('click', (e) => {
            if (e.target.classList.contains('remove-btn')) {
                const fileIndex = e.target.getAttribute('data-index');
                removeFile(fileIndex);
            }
        });

        function preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        }

        function handleDrop(e) {
            const dt = new DataTransfer();
            const droppedFiles = Array.from(e.dataTransfer.files);

            fileList.forEach(file => dt.items.add(file));

            for (const file of droppedFiles) {
                if (dt.items.length >= 10) {
                    alert("You can upload a maximum of 10 images!");
                    break;
                }
                dt.items.add(file);
            }

            fileList = Array.from(dt.files);
            fileInput.files = dt.files;
            updateFileListAndPreviews();
        }

        function handleFiles() {
            const newFiles = Array.from(fileInput.files);

            if (fileList.length + newFiles.length > 10) {
                alert("You can upload a maximum of 10 images!");
                return;
            }

            const dt = new DataTransfer();

            newFiles.forEach(file => dt.items.add(file));

            fileList.forEach(file => {
                if (!Array.from(newFiles).some(newFile => newFile.name === file.name)) {
                    dt.items.add(file);
                }
            });

            fileList = Array.from(dt.files);
            fileInput.files = dt.files;
            updateFileListAndPreviews();
        }

        function updateFileListAndPreviews() {
            previewContainer.innerHTML = '';
            fileList.forEach((file, index) => {
                if (!file.type.startsWith('image/')) return;

                const previewItem = document.createElement('div');
                previewItem.classList.add('preview-item');

                const img = document.createElement('img');
                img.classList.add('preview-img');

                const removeBtn = document.createElement('span');
                removeBtn.classList.add('remove-btn');
                removeBtn.innerText = '×';
                removeBtn.setAttribute('data-index', index);

                previewItem.appendChild(img);
                previewItem.appendChild(removeBtn);
                previewContainer.appendChild(previewItem);

                const reader = new FileReader();
                reader.onload = (e) => {
                    img.src = e.target.result;
                };
                reader.readAsDataURL(file);
            });
        }

        function removeFile(indexToRemove) {
            fileList.splice(indexToRemove, 1);
            updateFileListAndPreviews();
        }
    });
</script>
</body>
</html>
