<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Görsel Sıkıştırıcı</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #4a90e2;
            --background-color: #f0f4f8;
            --card-bg-color: #ffffff;
            --text-color: #34495e;
            --secondary-text-color: #7f8c8d;
            --border-color: #e0e6ed;
            --shadow-light: 0 4px 15px rgba(0, 0, 0, 0.05);
            --shadow-hover: 0 8px 25px rgba(0, 0, 0, 0.1);
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--background-color);
            color: var(--text-color);
        }
        .converter-card {
            background-color: var(--card-bg-color);
            border-radius: 24px;
            box-shadow: var(--shadow-light);
            padding: 2.5rem;
            border: none;
        }
        .card-title {
            font-weight: 700;
            color: var(--text-color);
            margin-bottom: 0.5rem;
        }
        .intro-text {
            color: var(--secondary-text-color);
            font-size: 1rem;
            line-height: 1.6;
        }
        .intro-text li {
            margin-bottom: 0.5rem;
        }
        .file-upload-area {
            border: 2px dashed var(--border-color);
            border-radius: 16px;
            transition: border-color 0.3s ease, background-color 0.3s ease;
            cursor: pointer;
            padding: 2.5rem 1.5rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        .file-upload-area.highlight {
            border-color: var(--primary-color);
            background-color: #f1f6ff;
        }
        .file-upload-btn, .submit-btn {
            background-color: var(--primary-color);
            border: none;
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 600;
            transition: background-color 0.3s ease, transform 0.2s ease;
        }
        .file-upload-btn:hover, .submit-btn:hover {
            background-color: #3871c2;
            transform: translateY(-2px);
        }
        .form-control, .form-select, .form-range {
            border-radius: 12px;
            border: 1px solid var(--border-color);
            padding: 10px 15px;
            transition: border-color 0.3s ease;
        }
        .form-control:focus, .form-range:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.25rem rgba(74, 144, 226, 0.25);
        }
        .form-label {
            font-weight: 600;
            color: var(--text-color);
            margin-bottom: 0.5rem;
        }
        .form-check-input:checked {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }
        .form-check-label {
            font-weight: 500;
            color: var(--text-color);
        }
        .preview-container {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-top: 20px;
            justify-content: center;
        }
        .preview-item {
            position: relative;
            width: 80px;
            height: 80px;
            border-radius: 12px;
            overflow: hidden;
            border: 2px solid var(--border-color);
        }
        .preview-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .remove-btn {
            position: absolute;
            top: -8px;
            right: -8px;
            background-color: #e74c3c;
            color: white;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            font-size: 16px;
            font-weight: bold;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
            transition: transform 0.2s ease;
        }
        .remove-btn:hover {
            transform: scale(1.1);
        }
        .feature-card {
            background-color: var(--card-bg-color);
            border-radius: 24px;
            box-shadow: var(--shadow-light);
            transition: transform 0.3s, box-shadow 0.3s;
            text-decoration: none;
            border: none;
        }
        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow-hover);
        }
        .card-icon svg {
            width: 64px;
            height: 64px;
            fill: var(--primary-color);
        }
        .card-title-link {
            font-weight: 600;
            color: var(--text-color);
            text-decoration: none;
        }
        .card-text {
            color: var(--secondary-text-color);
        }
    </style>
</head>
<body>
<div class="container my-5">
    <div class="card p-4 shadow-lg converter-card">
        <form method="POST" action="{{ path('app_image_compress') }}" enctype="multipart/form-data">
            <h1 class="card-title text-center mb-4">Görsel Sıkıştırıcı</h1>

            <ul class="intro-text lead mb-5 text-start">
                <li>Cihazınızdan en fazla 10 adet görsel seçebilirsiniz veya görselleri bırakma alanına sürükleyebilirsiniz.</li>
                <li>Seçili görsel en fazla 10 MB olmak zorundadır.</li>
            </ul>

            <div class="mb-3">
                <label for="image-upload" class="form-label fw-bold text-muted">Görselleri Seç (Çoklu)</label>
                <div id="drop-area" class="file-upload-area p-5 text-center">
                    <span class="text-muted d-block mb-2">Dosyaları buraya sürükle veya</span>
                    <label for="image-upload" class="btn btn-primary file-upload-btn">Dosya Seç</label>
                    <input type="file" id="image-upload" name="image[]" class="d-none" multiple required>
                </div>
            </div>
            <div id="preview-container" class="preview-container"></div>

            <div class="d-flex justify-content-around mb-3">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="resize_type" id="resize_pixels" value="pixels" checked>
                    <label class="form-check-label" for="resize_pixels">
                        Hedef Boyut (KB)
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="resize_type" id="resize_percentage" value="percentage">
                    <label class="form-check-label" for="resize_percentage">
                        Hedef Boyut (%)
                    </label>
                </div>
            </div>

            <div id="pixels_kb_container" class="mb-3">
                <label for="target_kb" class="form-label">Hedef Dosya Boyutu (KB)</label>
                <input type="number" class="form-control" id="target_kb" name="target_kb" value="100" min="10" max="1000">
            </div>

            <div id="percentage_range_container" class="mb-3" style="display:none;">
                <label for="compression_ratio" class="form-label ">
                    Hedef Dosya Boyutu <span id="quality_value">90%</span>
                </label>
                <input type="range" class="form-range" id="compression_ratio" name="compression_ratio" min="1" max="100" value="90">
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-3 submit-btn">Sıkıştır ve İndir</button>
        </form>
    </div>
</div>
<div class="container main-container text-center py-1">
    <div class="row g-4">
        <div class="col-md-6">
            <a href="{{ path('app_image_crop') }}" class="text-decoration-none">
                <div class="card p-5 feature-card h-100 d-flex flex-column align-items-center justify-content-center">
                    <span class="card-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-arrows-collapse" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h13a.5.5 0 0 1 0 1h-13A.5.5 0 0 1 1 8m13-3.5a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1 0-1h13a.5.5 0 0 1 .5.5m-13 7a.5.5 0 0 1 .5-.5h13a.5.5 0 0 1 0 1h-13a.5.5 0 0 1-.5-.5"/>
                        </svg>
                    </span>
                    <h2 class="card-title-link mt-3">Görsel Sıkıştırma</h2>
                    <p class="card-text text-center mt-2">Dosya boyutunu düşürerek hız kazanın. Kaliteyi korurken sıkıştırın.</p>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a href="{{ path('app_image_convert') }}" class="text-decoration-none">
                <div class="card p-5 feature-card h-100 d-flex flex-column align-items-center justify-content-center">
                    <span class="card-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-arrow-repeat" viewBox="0 0 16 16">
                            <path d="M11.534 7h3.932a.25.25 0 0 1 .192.41l-1.92 2.9A.25.25 0 0 1 13.52 10.5h-3.932a.25.25 0 0 1-.192-.41l1.92-2.9a.25.25 0 0 1 .192-.09m-7.068 0h3.932a.25.25 0 0 0 .192-.41L6.48 4.6A.25.25 0 0 0 6.48 4.6L4.56 1.7A.25.25 0 0 0 4.368 1.5h-3.932a.25.25 0 0 0-.192.41l1.92 2.9a.25.25 0 0 0-.192.41L1.76 10.5a.25.25 0 0 0 .192.41h3.932a.25.25 0 0 0 .192-.41l-1.92-2.9a.25.25 0 0 0-.192-.09m7.068 0h3.932a.25.25 0 0 0 .192-.41L13.52 4.6A.25.25 0 0 0 13.52 4.6L11.6 1.7A.25.25 0 0 0 11.408 1.5h-3.932a.25.25 0 0 0-.192.41l1.92 2.9a.25.25 0 0 0-.192.41L7.76 10.5a.25.25 0 0 0 .192.41h3.932a.25.25 0 0 0 .192-.41l-1.92-2.9a.25.25 0 0 0-.192-.09m-7.068 0h3.932a.25.25 0 0 0 .192-.41L6.48 4.6A.25.25 0 0 0 6.48 4.6L4.56 1.7A.25.25 0 0 0 4.368 1.5h-3.932a.25.25 0 0 0-.192.41l1.92 2.9a.25.25 0 0 0-.192.41L1.76 10.5a.25.25 0 0 0 .192.41h3.932a.25.25 0 0 0 .192-.41l-1.92-2.9a.25.25 0 0 0-.192-.09"/>
                        </svg>
                    </span>
                    <h2 class="card-title-link mt-3">Görsel Dönüştürme</h2>
                    <p class="card-text text-center mt-2">Farklı formatlara hızlı ve kolay dönüştürme.</p>
                </div>
            </a>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const dropArea = document.getElementById('drop-area');
        const fileInput = document.getElementById('image-upload');
        const previewContainer = document.getElementById('preview-container');

        let fileList = [];

        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropArea.addEventListener(eventName, preventDefaults, false);
        });
        ['dragenter', 'dragover'].forEach(eventName => {
            dropArea.addEventListener(eventName, () => dropArea.classList.add('highlight'), false);
        });
        ['dragleave', 'drop'].forEach(eventName => {
            dropArea.addEventListener(eventName, () => dropArea.classList.remove('highlight'), false);
        });

        dropArea.addEventListener('drop', handleDrop, false);
        fileInput.addEventListener('change', handleFiles, false);

        previewContainer.addEventListener('click', (e) => {
            if (e.target.classList.contains('remove-btn')) {
                const fileIndex = e.target.getAttribute('data-index');
                removeFile(fileIndex);
            }
        });

        function preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        }

        function handleDrop(e) {
            e.preventDefault();
            e.stopPropagation();

            const droppedFiles = Array.from(e.dataTransfer.files);

            const totalFiles = fileList.length + droppedFiles.length;
            if (totalFiles > 10) {
                alert('En fazla 10 dosya yükleyebilirsiniz!');
                return;
            }

            fileList = [...fileList, ...droppedFiles];

            const uniqueNames = new Set();
            fileList = fileList.filter(file => {
                if (uniqueNames.has(file.name)) {
                    return false;
                }
                uniqueNames.add(file.name);
                return true;
            });

            updateFileListAndPreviews();
        }

        function handleFiles() {
            const newFiles = Array.from(fileInput.files);
            const totalFiles = fileList.length + newFiles.length;

            if (totalFiles > 10) {
                alert('En fazla 10 dosya yükleyebilirsiniz!');
                return;
            }

            fileList = [...fileList, ...newFiles];

            const uniqueNames = new Set();
            fileList = fileList.filter(file => {
                if (uniqueNames.has(file.name)) {
                    return false;
                }
                uniqueNames.add(file.name);
                return true;
            });

            updateFileListAndPreviews();
        }

        function updateFileListAndPreviews() {

            const newFileList = new DataTransfer();
            fileList.forEach(file => {
                newFileList.items.add(file);
            });
            fileInput.files = newFileList.files;

            previewContainer.innerHTML = '';
            fileList.forEach((file, index) => {
                if (file.type.startsWith('image/')) {
                    const previewItem = document.createElement('div');
                    previewItem.classList.add('preview-item');

                    const img = document.createElement('img');
                    img.classList.add('preview-img');

                    const removeBtn = document.createElement('span');
                    removeBtn.classList.add('remove-btn');
                    removeBtn.innerText = '×';
                    removeBtn.setAttribute('data-index', index);

                    previewItem.appendChild(img);
                    previewItem.appendChild(removeBtn);
                    previewContainer.appendChild(previewItem);

                    const reader = new FileReader();
                    reader.onload = (e) => {
                        img.src = e.target.result;
                    };
                    reader.readAsDataURL(file);
                }
            });
        }

        function removeFile(indexToRemove) {
            fileList.splice(indexToRemove, 1);
            updateFileListAndPreviews();
        }
    });
</script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const pixelsRadio = document.getElementById('resize_pixels');
        const percentageRadio = document.getElementById('resize_percentage');

        const pixelsKbContainer = document.getElementById('pixels_kb_container');
        const percentageRangeContainer = document.getElementById('percentage_range_container');

        function toggleInputs() {
            if (pixelsRadio.checked) {
                pixelsKbContainer.style.display = 'block';
                percentageRangeContainer.style.display = 'none';
            } else if (percentageRadio.checked) {
                pixelsKbContainer.style.display = 'none';
                percentageRangeContainer.style.display = 'block';
            }
        }

        pixelsRadio.addEventListener('change', toggleInputs);
        percentageRadio.addEventListener('change', toggleInputs);

        toggleInputs();

    });
    document.addEventListener('DOMContentLoaded', () => {
        const compression_ratio = document.getElementById('compression_ratio');
        const qualityValue = document.getElementById('quality_value');

        qualityValue.textContent = compression_ratio.value + '%';

        compression_ratio.addEventListener('input', () => {
            qualityValue.textContent = compression_ratio.value + '%';
        });
    });
</script>
</body>
</html>
